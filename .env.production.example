# Copy thành .env.production trên server, rồi sửa các giá trị bên dưới.
# Supabase: Dashboard → Connect → ORM → Prisma (không thêm sslmode=require)

# Pooler transaction mode — app runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30"
# Pooler session mode — prisma migrate deploy (container start)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?connect_timeout=30"

# Port host expose ra ngoài (nginx reverse proxy thường trỏ vào đây)
HOST_PORT=3001

JWT_SECRET=change-me-random-64-chars-minimum
JWT_EXPIRES_IN=7d

# URL frontend (CORS + link mời nhân viên)
CORS_ORIGIN=https://your-frontend.example.com
APP_PUBLIC_URL=https://your-frontend.example.com

# URL public của backend (ảnh upload)
PUBLIC_UPLOAD_URL=https://api.your-domain.com/uploads

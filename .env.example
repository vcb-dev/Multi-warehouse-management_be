# PostgreSQL
# Local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vien_chi_bao?schema=public"
#
# Supabase — lấy từ Dashboard → Connect → ORM → Prisma:
# DATABASE_URL  = Transaction pooler (port 6543, ?pgbouncer=true) — dùng khi chạy app
# DIRECT_URL    = Direct connection (port 5432) — dùng cho prisma migrate deploy
DATABASE_URL=""
DIRECT_URL=""

# Server — Railway tự set PORT; không cần khai báo thủ công
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Production (Railway) — URL công khai của frontend / backend
# APP_PUBLIC_URL=https://your-frontend.example.com
# PUBLIC_UPLOAD_URL=https://your-backend.up.railway.app/uploads

# Integration tests (inventory ledger) — cần Postgres đã migrate + seed
# RUN_INTEGRATION_TESTS=1

# Job đối soát sổ cái định kỳ (ms); 0 = tắt. Hoặc: npm run reconcile
# RECONCILE_INTERVAL_MS=86400000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Giao Hàng Nhanh (GHN)
# production = Token/ShopId công ty | sandbox = Token test trên api.ghn.vn
GHN_ENV=production
# Tuỳ chọn ghi đè URL (thắng GHN_ENV):
# GHN_BASE_URL=https://online-gateway.ghn.vn
# GHN_BASE_URL=https://dev-online-gateway.ghn.vn
# Tuỳ chọn — nếu set, webhook POST /fulfillments/webhook/ghn phải gửi header X-GHN-Webhook-Secret
# GHN_WEBHOOK_SECRET=

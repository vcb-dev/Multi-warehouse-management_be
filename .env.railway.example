# Biến môi trường cho service API trên Railway (Settings → Variables).
# Chỉ liệt kê phần LIÊN QUAN TỚI PHIÊN ĐĂNG NHẬP + hạ tầng bắt buộc; các khoá tích hợp
# (Sapo, Shopee, TikTok, GHN, VTP) copy từ .env local sang.

# ─── Luồng auth: FE trên Vercel proxy /api sang đây ──────────────────────────
# Trình duyệt KHÔNG gọi thẳng domain Railway nữa. Nó gọi
#   https://multi-warehouse-management-fe-beta.vercel.app/api/*
# và `rewrites()` trong next.config.ts của FE chuyển tiếp sang đây. Cookie phiên vì thế
# do domain Vercel đặt cho chính nó — first-party, không phải cookie bên thứ ba.

# Bắt buộc: `CsrfGuard` đối chiếu header `Origin` (Vercel chuyển tiếp nguyên vẹn) với
# danh sách này. Thiếu domain Vercel là MỌI lệnh ghi trả 403 CSRF_ORIGIN_REJECTED.
# Muốn dùng cả bản preview của Vercel thì thêm domain preview vào đây, ngăn bằng dấu phẩy.
CORS_ORIGIN="https://multi-warehouse-management-fe-beta.vercel.app"

# Để trống: trình duyệt thấy cookie là first-party nên `lax` là đúng và chặt hơn `none`.
# ĐỪNG đặt "none" nữa — đó là cấu hình của mô hình gọi thẳng, và Safari/Brave chặn.
AUTH_COOKIE_SAMESITE=""

# Để trống: NODE_ENV=production tự bật `Secure` (xem src/common/auth/cookies.ts).
AUTH_COOKIE_SECURE=""

# ĐỪNG KHAI. Cookie phải là host-only của domain Vercel; khai domain Railway vào đây là
# trình duyệt vứt cookie ngay lúc nhận vì không khớp domain đang mở.
# AUTH_COOKIE_DOMAIN=

# 2 lớp proxy: Vercel → Railway. Thiếu (=1) thì `req.ip` là IP egress của Vercel, dùng
# CHUNG cho mọi người dùng, và bộ đếm /auth/refresh thành một rổ chung.
TRUST_PROXY_HOPS="2"

# Link lời mời gửi qua email trỏ về FE.
APP_PUBLIC_URL="https://multi-warehouse-management-fe-beta.vercel.app"

NODE_ENV="production"

# ─── Hạ tầng ─────────────────────────────────────────────────────────────────
DATABASE_URL=""
# Nếu schema còn `directUrl`: đặt bằng đúng DATABASE_URL
DIRECT_URL=""
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Ảnh upload do BE phục vụ tĩnh ở /uploads, KHÔNG đi qua proxy `/api` — để nguyên domain
# Railway. (Ổ đĩa Railway là ephemeral: file mất sau mỗi lần deploy lại.)
PUBLIC_UPLOAD_URL="https://warehouse-be-production.up.railway.app/uploads"

# Biến môi trường cần khai báo trên Railway (Service → Variables).
# DB: Supabase — Dashboard → Connect → ORM → Prisma (không dùng sslmode=require)

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?connect_timeout=30

JWT_SECRET=change-me-random-64-chars-minimum
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://your-frontend.example.com
APP_PUBLIC_URL=https://your-frontend.example.com
PUBLIC_UPLOAD_URL=https://your-backend.up.railway.app/uploads

# Railway tự inject PORT — không cần set

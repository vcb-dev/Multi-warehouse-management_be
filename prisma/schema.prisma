// Prisma schema tổng — Warehouse + CQA CRM (shared database)
// Chi tiết kho: specs/006-quan-ly-kho/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---

enum UserRole {
  warehouse_staff
  purchasing
  store_manager
  sales
  admin
}

enum PermissionScope {
  system
  location
}

enum AccountStatus {
  invited
  active
  inactive
}

enum InventoryBucket {
  on_hand
  available
  committed
  packed
  reserved
  unavailable
  incoming
}

enum MovementType {
  receipt
  transfer_out
  transfer_in
  return_out
  return_in
  adjust
  order_reserve
  order_release
  order_ship
  packing_start
  packing_cancel
  incoming_po
  incoming_receipt
  incoming_cancel
  incoming_transfer
  transfer_reserve
  transfer_release
}

enum PoStatus {
  don_nhap
  cho_nhap
  da_nhap
  huy
}

enum GoodsReceiptStatus {
  chua_nhap
  da_nhap
  huy
}

enum PaymentStatus {
  chua_thanh_toan
  mot_phan
  da_thanh_toan
}

enum StockTransferStatus {
  nhap
  cho_chuyen
  dang_chuyen
  da_nhan
  huy
}

enum RefundStatus {
  chua_hoan_tien
  da_hoan_tien
}

enum CategoryConditionType {
  manual
  auto
}

/// Theo Sapo — chỉ còn 3 giá trị thô (open/closed/cancelled). "ordered" vs
/// "processing" cũ nay phân biệt bằng Order.confirmedOn (null = chưa xác nhận);
/// "returned" cũ tách hẳn thành OrderReturnStatus, không còn ghi đè status nữa.
enum OrderStatus {
  open
  closed
  cancelled
}

/// Theo Sapo `financial_status` — thay cho PaymentStatus (PaymentStatus vẫn
/// dùng riêng cho GoodsReceipt, không đụng tới).
enum OrderFinancialStatus {
  pending
  partially_paid
  paid
  refunded
  partially_refunded
}

/// Theo Sapo `fulfillment_status` — null (chưa xử lý) mô hình bằng field nullable,
/// enum chỉ giữ 2 giá trị non-null.
enum OrderFulfillmentStatus {
  partial
  fulfilled
}

/// Theo Sapo `return_status`
enum OrderReturnStatus {
  no_return
  in_progress
  returned
}

/// Sapo `refund_line_item.restock_type` — vì sao dòng hàng này rời/không rời kho
enum RestockType {
  /// Huỷ đơn (hàng chưa từng ra khỏi kho)
  cancel
  /// Khách trả hàng về, nhập lại kho
  return_item
  /// Không nhập lại kho (hàng hỏng, thất lạc...)
  no_restock
}

/// Sapo `order.restock_status`
enum OrderRestockStatus {
  no_restock
  restocked
  partial
}

/// Theo Sapo `refund_status`
enum OrderRefundStatus {
  no_refund
  refunded
  partial
}

enum DraftOrderStatus {
  draft
  confirmed
}

enum OrderSource {
  facebook
  tiktok
  shopee
  pos
  web
  zalo
  live_fb
  warranty
  sapo
  other
}

enum VoucherType {
  receipt
  payment
}

/// Sapo `packed_status` của Fulfillment
enum PackingStatus {
  unknown
  packing
  packed
}

/// Sapo `shipment_status` của Fulfillment
enum ShipmentStatus {
  pending
  picked_up
  delivering
  delivered
  retry_delivery
  returning
  returned
  cancelled
}

/// Sapo `delivery_method` — cách hàng rời kho
enum FulfillmentDeliveryMethod {
  external_service
  ecommerce
  pick_up
  external_shipper
  outside_shipper
}

/// Sapo `shipment_category`
enum ShipmentCategory {
  fast
  other
}

/// Sapo `package_category`
enum PackageCategory {
  single_item_quantity
  single_item_multiple_quantity
  multiple_items
}

enum ShippingProviderType {
  tich_hop
  tu_lien_he
}

enum ShippingFeePayer {
  shop_tra
  khach_tra
}

enum OrderDeliveryMode {
  giao_hang_sau
  cong_van_chuyen
  tu_giao_hang
  da_giao_hang
}

/// Chủ đề thông báo. Giá trị lưu trong DB dùng ĐÚNG vocabulary topic webhook của Sapo
/// (`orders/create`, `fulfillments/update`...) — xác nhận qua `/admin/webhooks.json`
/// (endpoint duy nhất của mảng thông báo mà Open API mở; `/admin/notifications.json`
/// trả 401, `email_templates`/`notification_templates`/`alerts` trả 403).
///
/// Hiện sự kiện sinh 100% từ domain nội bộ, KHÔNG có webhook Sapo nào được đăng ký.
/// Đặt tên trùng Sapo từ đầu để sau này bật webhook thật thì không phải đổi tên sự kiện,
/// không phải migrate dữ liệu cũ.
enum NotificationTopic {
  orders_create       @map("orders/create")
  orders_paid         @map("orders/paid")
  orders_cancelled    @map("orders/cancelled")
  orders_fulfilled    @map("orders/fulfilled")
  fulfillments_create @map("fulfillments/create")
  fulfillments_update @map("fulfillments/update")
  refunds_create      @map("refunds/create")
  customers_create    @map("customers/create")

  // --- MỞ RỘNG NGOÀI SAPO — hai giá trị dưới KHÔNG phải topic webhook Sapo ---
  //
  // Sapo không có topic nào cho cảnh báo tồn kho. Gần nhất là `inventory_levels/update`
  // nhưng nó nghĩa là "mọi thay đổi tồn" (bắn mỗi lần xuất/nhập một cái) — dùng cho
  // cảnh báo sẽ sai nghĩa VÀ đụng nhau nếu sau này đăng ký webhook Sapo thật.
  // Vì vậy đặt tiền tố `inventory/` riêng, không lẫn với `inventory_levels/` của Sapo.

  /// Cần nhập hàng — theo công thức định mức của khách trong inventory-nxt.service.ts
  /// (`can_nhap_15 > 0`), KHÔNG phải ngưỡng cứng `available <= 5`: đo trên dữ liệu thật
  /// 17/08/2026, ngưỡng cứng khớp 17.001/17.710 dòng (96%) nên vô dụng làm cảnh báo,
  /// còn `can_nhap_15 > 0` chỉ khớp 175 dòng.
  inventory_low_stock @map("inventory/low_stock")

  /// Âm kho (`available < 0`) — bán quá tay hoặc lệch sổ. 756 dòng lúc đo.
  inventory_negative @map("inventory/negative")
}

// --- Auth & config ---

// --- CQA multi-tenant ---

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  domain       String?  @db.VarChar
  logoUrl      String?  @map("logo_url") @db.VarChar
  primaryColor String?  @map("primary_color") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  chatAudits  ChatAudit[]
  configs     FacebookCskhConfig[]
  sessions    FacebookOAuthSession[]
  jobs        CskhJobRun[]
  monitors    CskhMonitorItem[]
  convs       CskhInboxConversation[]
  messages    CskhInboxMessage[]
  inboxLabels CskhInboxLabel[]

  @@map("tenants")
}

model User {
  id              BigInt        @id @default(autoincrement())
  sapoId          BigInt?       @unique @map("sapo_id")
  email           String        @unique
  passwordHash    String?       @map("password_hash")
  firstName       String?       @map("first_name")
  lastName        String?       @map("last_name")
  phoneNumber     String?       @map("phone_number")
  url             String?
  tenantId        String?       @map("tenant_id") @db.Uuid
  roles           UserRole[]    @default([])
  status          AccountStatus @default(active)
  active          Boolean       @default(true)
  // Tăng lên để vô hiệu hoá MỌI token đã phát của user (đăng xuất toàn bộ thiết
  // bị, đổi mật khẩu, nghi lộ token). JWT mang `ver` lúc ký; `JwtStrategy` đối
  // chiếu trong đúng lượt tra DB vốn đã chạy mỗi request nên không tốn thêm query.
  // Tham chiếu thô từ /admin/users.json — KHÔNG điều khiển nghiệp vụ (RBAC
  // nội bộ vẫn là nguồn thật duy nhất). Bảng users hiện không đồng bộ với
  // Sapo (không có sapo_id nào khớp thật), nên các field này luôn NULL cho
  // tới khi có luồng đồng bộ tài khoản Sapo thật.
  sapoRoles       String?       @map("sapo_roles")
  sapoPermissions Json?         @map("sapo_permissions")
  createdOn       DateTime      @default(now()) @map("created_on")
  modifiedOn      DateTime      @updatedAt @map("modified_on")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  locations              UserLocation[]
  locationRoles          UserLocationRole[]
  permissionOverrides    UserPermissionOverride[]
  sessions               UserSession[]
  invitations            UserInvitation[]
  inventoryMoves         InventoryMovement[]         @relation("MovementCreatedBy")
  activityLogs           ActivityLog[]
  assignedSuppliers      Supplier[]                  @relation("SupplierAssignedTo")
  purchaseOrders         PurchaseOrder[]             @relation("PoCreatedBy")
  goodsReceipts          GoodsReceipt[]              @relation("ReiCreatedBy")
  goodsReceiptsAssigned  GoodsReceipt[]              @relation("ReiAssignedTo")
  stockTransfersCreated  StockTransfer[]             @relation("StnCreatedBy")
  stockTransfersReceived StockTransfer[]             @relation("StnReceivedBy")
  purchaseReturns        PurchaseReturn[]            @relation("PvnCreatedBy")
  ordersCreated          Order[]                     @relation("OrderCreatedBy")
  ordersAssigned         Order[]                     @relation("OrderAssignedTo")
  orderReturns           OrderReturn[]               @relation("OrderReturnCreatedBy")
  orderRefunds           OrderRefund[]               @relation("OrderRefundCreatedBy")
  draftOrders            DraftOrder[]                @relation("DraftOrderCreatedBy")
  vouchersCreated        Voucher[]                   @relation("VoucherCreatedBy")
  supplierLedgerEntries  SupplierLedgerEntry[]       @relation("SupplierLedgerCreatedBy")
  customerLedgerEntries  CustomerLedgerEntry[]       @relation("CustomerLedgerCreatedBy")
  conversationsAssigned  Conversation[]              @relation("ConversationAssignedTo")
  conversationMessages   ConversationMessage[]       @relation("ConversationMessageAuthor")
  chatAudits             ChatAudit[]
  inboxLabels            CskhInboxLabel[]
  inboxConvViews         CskhInboxConversationView[]
  packedFulfillments     Fulfillment[]               @relation("FulfillmentPacker")
  createdFulfillments    Fulfillment[]               @relation("FulfillmentCreatedBy")
  createdCarrierTickets  CarrierTicket[]             @relation("CarrierTicketCreatedBy")
  savedReports           SavedReport[]               @relation("SavedReportUser")
  notifications          NotificationRecipient[]     @relation("NotificationRecipient")
  apiKeysCreated         ApiKey[]                    @relation("ApiKeyCreatedBy")
  apiKeysActingAs        ApiKey[]                    @relation("ApiKeyActingUser")
  variantPriceHistories  VariantPriceHistory[]       @relation("VariantPriceHistoryChangedBy")

  @@map("users")
}

model UserLocation {
  userId     BigInt @map("user_id")
  locationId BigInt @map("location_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@map("user_locations")
}

// --- RBAC động (009) ---

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions   RolePermission[]
  locationRoles UserLocationRole[]

  @@map("roles")
}

model Permission {
  id    BigInt          @id @default(autoincrement())
  key   String          @unique
  group String
  label String
  scope PermissionScope

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserLocationRole {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  locationId BigInt   @map("location_id")
  roleId     BigInt   @map("role_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, locationId])
  @@map("user_location_roles")
}

// Lệch quyền riêng cho một user tại một kho, chồng lên quyền mặc định của
// role gán tại (user, kho) — không đổi role hay ảnh hưởng user khác.
// granted=true: thêm quyền role không có. granted=false: bỏ quyền role có sẵn.
model UserPermissionOverride {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  locationId   BigInt   @map("location_id")
  permissionId BigInt   @map("permission_id")
  granted      Boolean
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId, permissionId])
  @@map("user_permission_overrides")
}

/// Phiên đăng nhập. Token phát cho client là chuỗi ngẫu nhiên không mang thông tin
/// (opaque), chỉ có ý nghĩa khi đối chiếu được với một dòng ở đây — khác JWT ở chỗ
/// không tự chứng minh được tính hợp lệ, nên xoá dòng là token chết ngay lập tức.
///
/// Chỉ lưu SHA-256 của token, không lưu bản thô: rò database không kéo theo mạo danh
/// được người dùng.
model UserSession {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  /// SHA-256 của token thô. Token thô chỉ tồn tại ở lần trả về lúc đăng nhập.
  tokenHash  String    @unique @map("token_hash")
  /// Để người dùng nhận ra thiết bị nào là của mình trong màn quản lý phiên.
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  /// Đánh dấu thay vì xoá hẳn, để còn tra được lịch sử khi điều tra sự cố.
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserInvitation {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_invitations")
}

model Location {
  id                     BigInt    @id @default(autoincrement())
  sapoId                 BigInt?   @unique @map("sapo_id")
  storeId                BigInt?   @map("store_id")
  /// 15/16 location trên Sapo để trống code ⇒ phải nullable
  code                   String?   @unique
  name                   String
  email                  String?
  phone                  String?
  address1               String?
  address2               String?
  city                   String?
  province               String?
  provinceCode           String?   @map("province_code")
  district               String?
  districtCode           String?   @map("district_code")
  ward                   String?
  wardCode               String?   @map("ward_code")
  country                String?
  countryCode            String?   @map("country_code")
  zip                    String?
  /// Sapo dùng chuỗi "active"/"inactive", không phải boolean
  status                 String    @default("active")
  defaultLocation        Boolean   @default(false) @map("default_location")
  fulfillOrder           Boolean   @default(false) @map("fulfill_order")
  fulfillmentPickup      Boolean   @default(false) @map("fulfillment_pickup")
  inventoryManagement    Boolean   @default(true) @map("inventory_management")
  deactivateInventoryAt  DateTime? @map("deactivate_inventory_at")
  offlineStore           Boolean   @default(false) @map("offline_store")
  ownerType              String?   @map("owner_type")
  inventoryProcessStatus String?   @map("inventory_process_status")
  createdOn              DateTime  @default(now()) @map("created_on")
  modifiedOn             DateTime  @updatedAt @map("modified_on")

  users               UserLocation[]
  userRoles           UserLocationRole[]
  permissionOverrides UserPermissionOverride[]
  inventoryLevels     InventoryLevel[]
  movements           InventoryMovement[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  transfersFrom       StockTransfer[]          @relation("TransferFrom")
  transfersTo         StockTransfer[]          @relation("TransferTo")
  purchaseReturns     PurchaseReturn[]
  refundLineItems     OrderRefundLineItem[]
  priceLists          PriceList[]
  orders              Order[]
  draftOrders         DraftOrder[]
  vouchers            Voucher[]
  fulfillments        Fulfillment[]
  channelConnections  ChannelConnection[]
  notifications       Notification[]           @relation("NotificationLocation")

  @@index([status])
  @@map("locations")
}

/// Kết nối OAuth trực tiếp tới kênh bán (Shopee/TikTok Shop), bypass Sapo.
/// Mỗi gian hàng (shop) trên kênh ứng với 1 dòng riêng — 1 tài khoản có thể có nhiều shop.
model ChannelConnection {
  id       BigInt      @id @default(autoincrement())
  channel  OrderSource @map("channel")
  /// Định danh shop trên kênh — TikTok Shop gọi là `open_id`, Shopee gọi là `shop_id`.
  shopId   String      @map("shop_id")
  shopName String?     @map("shop_name")

  accessToken           String   @map("access_token") @db.Text
  accessTokenExpiresAt  DateTime @map("access_token_expires_at")
  refreshToken          String   @map("refresh_token") @db.Text
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at")
  grantedScopes         String[] @default([]) @map("granted_scopes")

  /// Kho đại diện cho tồn kho/đơn hàng của shop này (giống WOO_LOCATION_ID) — để trống nếu chưa gán.
  locationId BigInt?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([channel, shopId])
  @@map("channel_connections")
}

/// SKU có trên đơn của kênh bán nhưng không khớp `ProductVariant.sku`.
///
/// Dòng hàng như vậy không chèn được vào `order_items` (`variant_id` là FK bắt buộc) nên
/// bị bỏ khi đồng bộ; bảng này giữ lại dấu vết để màn Kênh bán chỉ ra đang thiếu SKU nào
/// và bỏ sót bao nhiêu doanh số, thay vì im lặng nuốt mất.
model ChannelSkuGap {
  id      BigInt      @id @default(autoincrement())
  channel OrderSource
  sku     String

  /// Tên kênh trả về — để người dùng nhận ra hàng nào mà không phải tra ngược sang sàn
  productName String? @map("product_name")
  variantName String? @map("variant_name")

  /// Cộng dồn qua các lần đồng bộ
  lineCount Int     @default(0) @map("line_count")
  quantity  Int     @default(0)
  amount    Decimal @default(0) @db.Decimal(18, 2)

  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([channel, sku])
  @@map("channel_sku_gaps")
}

// --- Module Sản phẩm (005) ---

/// Sapo `customer_groups` — cùng dạng rule như custom_collections
model CustomerGroup {
  id             BigInt   @id @default(autoincrement())
  sapoId         BigInt?  @unique @map("sapo_id")
  /// Mã nội bộ của dự án (Sapo không có) — dùng cho bảng giá
  code           String   @unique
  name           String
  note           String?  @db.Text
  /// Sapo `type` — auto (theo rules) | manual (chọn tay)
  type           String   @default("manual")
  /// Sapo `disjunctive`: true = thoả 1 rule bất kỳ (OR), false = thoả mọi rule (AND)
  disjunctive    Boolean  @default(false)
  /// Sapo `rules[]` — [{column, relation, condition}]
  rules          Json?
  customersCount Int      @default(0) @map("customers_count")
  catalogsCount  Int      @default(0) @map("catalogs_count")
  createdOn      DateTime @default(now()) @map("created_on")
  modifiedOn     DateTime @updatedAt @map("modified_on")

  priceLists PriceList[]
  members    CustomerGroupMember[]

  @@map("customer_groups")
}

/// Bảng nối khách ⇄ nhóm (Sapo: GET /admin/customer_groups/{id}/customers.json)
model CustomerGroupMember {
  customerId      BigInt   @map("customer_id")
  customerGroupId BigInt   @map("customer_group_id")
  createdOn       DateTime @default(now()) @map("created_on")

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  group    CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)

  @@id([customerId, customerGroupId])
  @@index([customerGroupId])
  @@map("customer_group_members")
}

/// Theo Sapo `/admin/products.json`. Các cờ requires_shipping/taxable/
/// inventory_management/inventory_policy/unit sống ở ProductVariant như Sapo
/// (xem docs/sapo-schema-mapping.md mục Phase 2).
model Product {
  id                 BigInt    @id @default(autoincrement())
  sapoId             BigInt?   @unique @map("sapo_id")
  alias              String    @unique
  name               String
  vendor             String?
  /// Không có ở Sapo — field riêng của dự án, giữ nguyên
  category           String?
  material           String?
  craftType          String?   @map("craft_type")
  isDiscontinued     Boolean   @default(false) @map("is_discontinued")
  productType        String?   @map("product_type")
  /// Sapo trả tags dạng chuỗi phân tách dấu phẩy; dự án giữ mảng để không phá
  /// logic lọc/khớp danh mục tự động — quy đổi khi đồng bộ với Sapo.
  tags               String[]  @default([])
  /// Không có ở Sapo — ảnh đại diện tiện dụng, nguồn thật là ProductImage đầu tiên
  imageUrl           String?   @map("image_url")
  metaTitle          String?   @map("meta_title")
  metaDescription    String?   @map("meta_description")
  content            String?   @db.Text
  summary            String?   @db.Text
  vatPitCategoryCode String?   @map("vat_pit_category_code")
  templateLayout     String?   @map("template_layout")
  type               String    @default("normal")
  /// Sapo dùng chuỗi ("active"/"draft"/...), không phải boolean is_published
  status             String    @default("draft")
  publishedOn        DateTime? @map("published_on")
  createdOn          DateTime  @default(now()) @map("created_on")
  modifiedOn         DateTime  @updatedAt @map("modified_on")

  variants      ProductVariant[]
  images        ProductImage[]
  options       ProductOption[]
  salesChannels ProductSalesChannel[]
  categories    ProductCategory[]

  @@index([vendor, productType])
  @@map("products")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  url       String
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductOption {
  id        BigInt @id @default(autoincrement())
  productId BigInt @map("product_id")
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  VariantOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductVariant {
  id                  BigInt   @id @default(autoincrement())
  productId           BigInt   @map("product_id")
  sapoId              BigInt?  @unique @map("sapo_id")
  /// Sapo InventoryItem.id — quan hệ 1:1 với variant, dùng để gọi API InventoryLevel
  inventoryItemId     BigInt?  @unique @map("inventory_item_id")
  sku                 String   @unique
  title               String?
  barcode             String?
  price               Decimal  @default(0) @db.Decimal(18, 2)
  compareAtPrice      Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  /// Không map trực tiếp field nào của Sapo variant — đồng bộ từ InventoryItem.cost_price (1:1 với variant)
  cost                Decimal  @default(0) @db.Decimal(18, 2)
  weight              Decimal? @db.Decimal(18, 4)
  weightUnit          String?  @map("weight_unit")
  /// Không có ở Sapo (Sapo dùng image_id trỏ ProductImage) — giữ URL tiện dụng, đỡ phải join
  imageUrl            String?  @map("image_url")
  /// Không có ở Sapo — cho phép ẩn variant khỏi bán mà không xóa (đã phát sinh chứng từ)
  enabled             Boolean  @default(true)
  unit                String?
  /// Dời từ Product xuống đây theo đúng Sapo (Phase 2)
  requiresShipping    Boolean  @default(true) @map("requires_shipping")
  taxable             Boolean  @default(true)
  /// Sapo: "bizweb" = có quản lý tồn qua hệ thống, "" = không quản lý
  inventoryManagement String   @default("bizweb") @map("inventory_management")
  /// Sapo: "deny" | "continue" (continue = cho phép bán khi hết hàng)
  inventoryPolicy     String   @default("deny") @map("inventory_policy")
  lotManagement       Boolean  @default(false) @map("lot_management")
  position            Int      @default(0)
  type                String   @default("normal")
  requiresComponents  Boolean  @default(false) @map("requires_components")

  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues     VariantOptionValue[]
  inventoryLevels  InventoryLevel[]
  movements        InventoryMovement[]
  poItems          PurchaseOrderItem[]
  reiItems         GoodsReceiptItem[]
  stnItems         StockTransferItem[]
  pvnItems         PurchaseReturnItem[]
  priceListItems   PriceListItem[]
  orderItems       OrderItem[]
  draftOrderItems  DraftOrderItem[]
  refundLineItems  OrderRefundLineItem[]
  fulfillmentItems FulfillmentLineItem[]
  priceHistories   VariantPriceHistory[]

  @@index([productId])
  @@map("product_variants")
}

model VariantPriceHistory {
  id          BigInt   @id @default(autoincrement())
  variantId   BigInt   @map("variant_id")
  field       String // "price" | "cost"
  oldValue    Decimal? @map("old_value") @db.Decimal(18, 2)
  newValue    Decimal  @map("new_value") @db.Decimal(18, 2)
  source      String   @default("manual") // "manual" | "import" | "create"
  changedById BigInt?  @map("changed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy User?          @relation("VariantPriceHistoryChangedBy", fields: [changedById], references: [id])

  @@index([variantId, createdAt(sort: Desc)])
  @@map("variant_price_histories")
}

model VariantOptionValue {
  variantId BigInt @map("variant_id")
  optionId  BigInt @map("option_id")
  value     String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option  ProductOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionId])
  @@map("variant_option_values")
}

/// Sapo `custom_collections` — danh mục sản phẩm
model Category {
  id              BigInt                @id @default(autoincrement())
  sapoId          BigInt?               @unique @map("sapo_id")
  name            String
  /// Sapo `alias` (trước đây là `slug`)
  alias           String                @unique
  description     String?               @db.Text
  metaTitle       String?               @map("meta_title")
  metaDescription String?               @map("meta_description")
  templateLayout  String?               @map("template_layout")
  /// Sapo `sort_order` — vd "created-desc", "alpha-asc", "manual"
  sortOrder       String?               @map("sort_order")
  publishedOn     DateTime?             @map("published_on")
  /// Sapo `products_count` — Sapo tính sẵn, chỉ dùng hiển thị
  productsCount   Int                   @default(0) @map("products_count")
  /// Sapo `image` là object — trải phẳng các field thực dùng
  imageSrc        String?               @map("image_src")
  imageAlt        String?               @map("image_alt")
  imageWidth      Int?                  @map("image_width")
  imageHeight     Int?                  @map("image_height")
  /// Sapo `rules` (mảng điều kiện) + `disjunctive` (true = OR, false = AND).
  /// `conditionType` là field riêng của dự án: manual = chọn tay, auto = theo rules.
  rules           Json?
  disjunctive     Boolean               @default(false)
  conditionType   CategoryConditionType @default(manual) @map("condition_type")
  /// Riêng của dự án — Sapo custom_collection không có cây phân cấp / kênh bán
  parentId        BigInt?               @map("parent_id")
  salesChannels   String[]              @default([]) @map("sales_channels")
  createdOn       DateTime              @default(now()) @map("created_on")
  modifiedOn      DateTime              @updatedAt @map("modified_on")

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@map("categories")
}

/// Sapo `collects` — bảng nối product ⇄ custom_collection
model ProductCategory {
  productId  BigInt   @map("product_id")
  categoryId BigInt   @map("category_id")
  /// Sapo `position` / `featured`
  position   Int      @default(0)
  featured   Boolean  @default(false)
  createdOn  DateTime @default(now()) @map("created_on")
  modifiedOn DateTime @updatedAt @map("modified_on")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductSalesChannel {
  productId BigInt @map("product_id")
  channel   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, channel])
  @@map("product_sales_channels")
}

model PriceList {
  id              BigInt   @id @default(autoincrement())
  code            String   @unique
  name            String
  locationId      BigInt?  @map("location_id")
  customerGroupId BigInt?  @map("customer_group_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  location      Location?       @relation(fields: [locationId], references: [id])
  customerGroup CustomerGroup?  @relation(fields: [customerGroupId], references: [id])
  items         PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id             BigInt   @id @default(autoincrement())
  priceListId    BigInt   @map("price_list_id")
  variantId      BigInt   @map("variant_id")
  fixedPrice     Decimal  @map("fixed_price") @db.Decimal(18, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(18, 2)
  enabled        Boolean  @default(true)

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId])
  @@index([variantId])
  @@map("price_list_items")
}

// --- Inventory core ---

/// Theo Sapo `/admin/inventory_levels.json`.
model InventoryLevel {
  variantId        BigInt   @map("variant_id")
  locationId       BigInt   @map("location_id")
  /// Id của InventoryItem bên Sapo (quan hệ 1:1 với variant)
  inventoryItemId  BigInt?  @map("inventory_item_id")
  onHand           Int      @default(0) @map("on_hand")
  available        Int      @default(0)
  committed        Int      @default(0)
  incoming         Int      @default(0)
  incomingOwned    Int      @default(0) @map("incoming_owned")
  incomingNotOwned Int      @default(0) @map("incoming_not_owned")
  /// Sapo gọi là `packed` (trước đây dự án đặt là `packing`)
  packed           Int      @default(0)
  reserved         Int      @default(0)
  unavailable      Int      @default(0)
  price            Decimal  @default(0) @db.Decimal(18, 2)
  cost             Decimal  @default(0) @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant  ProductVariant @relation(fields: [variantId], references: [id])
  location Location       @relation(fields: [locationId], references: [id])

  @@id([variantId, locationId])
  @@index([locationId])
  @@index([inventoryItemId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id            BigInt          @id @default(autoincrement())
  variantId     BigInt          @map("variant_id")
  locationId    BigInt          @map("location_id")
  bucket        InventoryBucket
  change        Int
  type          MovementType
  referenceType String?         @map("reference_type")
  referenceId   BigInt?         @map("reference_id")
  createdById   BigInt?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  createdBy User?          @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([variantId, locationId, bucket, createdAt]) // T046
  @@map("inventory_movements")
}

model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   BigInt?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("activity_logs")
}

// --- Nhà cung cấp (US5) ---

model Supplier {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique
  name         String
  email        String?
  phone        String?
  website      String?
  fax          String?
  taxCode      String?  @map("tax_code")
  country      String?
  province     String?
  district     String?
  ward         String?
  address      String?
  assignedToId BigInt?  @map("assigned_to")
  tags         String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedTo User? @relation("SupplierAssignedTo", fields: [assignedToId], references: [id])

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  purchaseReturns PurchaseReturn[]
  ledgerEntries   SupplierLedgerEntry[]

  @@map("suppliers")
}

enum SupplierLedgerReferenceType {
  goods_receipt
  payment
  purchase_return
  refund
  adjustment
}

// Sổ công nợ NCC — amount: âm = tăng nợ phải trả NCC, dương = giảm nợ phải trả NCC
model SupplierLedgerEntry {
  id               BigInt                      @id @default(autoincrement())
  supplierId       BigInt                      @map("supplier_id")
  referenceType    SupplierLedgerReferenceType @map("reference_type")
  referenceCode    String?                     @map("reference_code")
  transactionLabel String                      @map("transaction_label")
  reason           String?
  amount           Decimal                     @db.Decimal(18, 2)
  createdById      BigInt                      @map("created_by")
  createdAt        DateTime                    @default(now()) @map("created_at")

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("SupplierLedgerCreatedBy", fields: [createdById], references: [id])

  @@index([supplierId, createdAt])
  @@map("supplier_ledger_entries")
}

// --- Đặt hàng nhập & Nhập hàng (US2) ---

model PurchaseOrder {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique
  supplierId    BigInt   @map("supplier_id")
  /// Gộp từ branch_id + warehouse_id cũ — Sapo chỉ có một location cho đơn nhập
  locationId    BigInt   @map("location_id")
  status        PoStatus @default(don_nhap)
  totalQuantity Int      @default(0) @map("total_quantity")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(18, 2)
  depositAmount Decimal  @default(0) @map("deposit_amount") @db.Decimal(18, 2)
  createdById   BigInt   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  location          Location            @relation(fields: [locationId], references: [id])
  createdBy         User                @relation("PoCreatedBy", fields: [createdById], references: [id])
  items             PurchaseOrderItem[]
  goodsReceipts     GoodsReceipt[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               BigInt  @id @default(autoincrement())
  purchaseOrderId  BigInt  @map("purchase_order_id")
  variantId        BigInt  @map("variant_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 2)
  receivedQuantity Int     @default(0) @map("received_quantity")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([purchaseOrderId, variantId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                BigInt             @id @default(autoincrement())
  code              String             @unique
  supplierId        BigInt             @map("supplier_id")
  locationId        BigInt             @map("location_id")
  purchaseOrderId   BigInt?            @map("purchase_order_id")
  status            GoodsReceiptStatus @default(chua_nhap)
  paymentStatus     PaymentStatus      @default(chua_thanh_toan) @map("payment_status")
  amountDue         Decimal            @default(0) @map("amount_due") @db.Decimal(18, 2)
  paidAmount        Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 2)
  discountAmount    Decimal            @default(0) @map("discount_amount") @db.Decimal(18, 2)
  extraCost         Decimal            @default(0) @map("extra_cost") @db.Decimal(18, 2)
  depositApplied    Decimal            @default(0) @map("deposit_applied") @db.Decimal(18, 2)
  assignedToId      BigInt?            @map("assigned_to")
  expectedReceiptAt DateTime?          @map("expected_receipt_at")
  invoiceAt         DateTime?          @map("invoice_at")
  invoiceSymbol     String?            @map("invoice_symbol")
  orderCode         String?            @map("order_code")
  referenceCode     String?            @map("reference_code")
  createdById       BigInt             @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  receivedAt        DateTime?          @map("received_at")

  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  location        Location           @relation(fields: [locationId], references: [id])
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  createdBy       User               @relation("ReiCreatedBy", fields: [createdById], references: [id])
  assignedTo      User?              @relation("ReiAssignedTo", fields: [assignedToId], references: [id])
  items           GoodsReceiptItem[]
  purchaseReturns PurchaseReturn[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              BigInt  @id @default(autoincrement())
  goodsReceiptId  BigInt  @map("goods_receipt_id")
  variantId       BigInt  @map("variant_id")
  purchaseOrderId BigInt? @map("purchase_order_id")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)

  goodsReceipt  GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([goodsReceiptId])
  @@index([variantId])
  @@map("goods_receipt_items")
}

// --- Chuyển kho (US3) ---

model StockTransfer {
  id             BigInt              @id @default(autoincrement())
  code           String              @unique
  fromLocationId BigInt              @map("from_location_id")
  toLocationId   BigInt              @map("to_location_id")
  status         StockTransferStatus @default(nhap)
  note           String?
  totalQuantity  Int                 @default(0) @map("total_quantity")
  createdById    BigInt              @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  shippedAt      DateTime?           @map("shipped_at")
  receivedAt     DateTime?           @map("received_at")
  receivedById   BigInt?             @map("received_by")

  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    User                @relation("StnCreatedBy", fields: [createdById], references: [id])
  receivedBy   User?               @relation("StnReceivedBy", fields: [receivedById], references: [id])
  items        StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              BigInt @id @default(autoincrement())
  stockTransferId BigInt @map("stock_transfer_id")
  variantId       BigInt @map("variant_id")
  quantity        Int

  stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([stockTransferId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

// --- Trả hàng nhập (US4) ---

model PurchaseReturn {
  id             BigInt       @id @default(autoincrement())
  code           String       @unique
  supplierId     BigInt       @map("supplier_id")
  locationId     BigInt       @map("location_id")
  // Đơn nhập hàng gốc — có giá trị khi tạo phiếu trả "theo đơn", null khi trả tự do
  goodsReceiptId BigInt?      @map("goods_receipt_id")
  totalQuantity  Int          @default(0) @map("total_quantity")
  totalAmount    Decimal      @default(0) @map("total_amount") @db.Decimal(18, 2)
  refundStatus   RefundStatus @default(chua_hoan_tien) @map("refund_status")
  refundedAt     DateTime?    @map("refunded_at")
  createdById    BigInt       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  location     Location             @relation(fields: [locationId], references: [id])
  goodsReceipt GoodsReceipt?        @relation(fields: [goodsReceiptId], references: [id])
  createdBy    User                 @relation("PvnCreatedBy", fields: [createdById], references: [id])
  items        PurchaseReturnItem[]

  @@index([supplierId, createdAt])
  @@index([goodsReceiptId])
  @@index([createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               BigInt  @id @default(autoincrement())
  purchaseReturnId BigInt  @map("purchase_return_id")
  variantId        BigInt  @map("variant_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(18, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseReturnId])
  @@index([variantId])
  @@map("purchase_return_items")
}

// --- Module Đơn hàng (002) ---

/// Sapo `customers`
model Customer {
  id               BigInt    @id @default(autoincrement())
  sapoId           BigInt?   @unique @map("sapo_id")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  email            String?
  phone            String?
  company          String?
  tags             String[]  @default([])
  note             String?   @db.Text
  /// Sapo `state` — enabled | disabled | invited
  state            String    @default("enabled")
  verifiedEmail    Boolean   @default(false) @map("verified_email")
  /// Sapo `gender` — male | female | other (chuỗi tự do như Sapo, không enum)
  gender           String?
  dob              DateTime?
  acceptsMarketing Boolean   @default(false) @map("accepts_marketing")
  /// Sapo lưu sẵn các số tổng hợp này trên customer — đồng bộ để lọc/sắp xếp
  /// nhanh; giá trị sống vẫn tính lại từ bảng orders khi hiển thị chi tiết.
  ordersCount      Int       @default(0) @map("orders_count")
  totalSpent       Decimal   @default(0) @map("total_spent") @db.Decimal(18, 2)
  lastOrderId      BigInt?   @map("last_order_id")
  lastOrderName    String?   @map("last_order_name")
  createdOn        DateTime  @default(now()) @map("created_on")
  modifiedOn       DateTime  @updatedAt @map("modified_on")

  orders        Order[]
  draftOrders   DraftOrder[]
  conversations Conversation[]
  ledgerEntries CustomerLedgerEntry[]
  addresses     CustomerAddress[]
  groups        CustomerGroupMember[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

/// Sapo `customer.addresses[]` — một khách có thể có nhiều địa chỉ, 1 cái mặc định
model CustomerAddress {
  id           BigInt  @id @default(autoincrement())
  sapoId       BigInt? @unique @map("sapo_id")
  customerId   BigInt  @map("customer_id")
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  phone        String?
  company      String?
  address1     String?
  address2     String?
  ward         String?
  wardCode     String? @map("ward_code")
  district     String?
  districtCode String? @map("district_code")
  province     String?
  provinceCode String? @map("province_code")
  city         String?
  country      String?
  countryCode  String? @map("country_code")
  zip          String?
  /// Sapo `default` — `default` là từ khoá SQL nên đặt cột là `is_default`
  isDefault    Boolean @default(false) @map("is_default")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

enum CustomerLedgerReferenceType {
  order
  payment
  order_return
  refund
  adjustment
}

// Sổ công nợ KH — amount: dương = tăng nợ phải thu (khách nợ thêm), âm = giảm nợ phải thu
model CustomerLedgerEntry {
  id               BigInt                      @id @default(autoincrement())
  customerId       BigInt                      @map("customer_id")
  referenceType    CustomerLedgerReferenceType @map("reference_type")
  referenceCode    String?                     @map("reference_code")
  transactionLabel String                      @map("transaction_label")
  reason           String?
  amount           Decimal                     @db.Decimal(18, 2)
  createdById      BigInt                      @map("created_by")
  createdAt        DateTime                    @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation("CustomerLedgerCreatedBy", fields: [createdById], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_ledger_entries")
}

model Order {
  id                BigInt                  @id @default(autoincrement())
  sapoId            BigInt?                 @unique @map("sapo_id")
  /// Sapo `name` — mã đơn. Đơn đồng bộ dùng đúng mã Sapo trả về (HK93027,
  /// 585144452587096032...); đơn tạo tại app dùng mã app tự sinh (CNHN000001).
  name              String                  @unique
  /// Sapo `number` / `order_number` — số thứ tự đơn trong store (chỉ đơn đồng bộ)
  number            Int?
  orderNumber       Int?                    @map("order_number")
  customerId        BigInt?                 @map("customer_id")
  locationId        BigInt                  @map("location_id")
  /// Sapo `source_name` — kênh bán (facebook/tiktokshop/shopee/web/pos/zalo/...).
  /// Là chuỗi tự do (không enum) vì Sapo liên tục thêm kênh mới.
  sourceName        String?                 @map("source_name")
  status            OrderStatus             @default(open)
  financialStatus   OrderFinancialStatus    @default(pending) @map("financial_status")
  fulfillmentStatus OrderFulfillmentStatus? @map("fulfillment_status")
  returnStatus      OrderReturnStatus       @default(no_return) @map("return_status")
  refundStatus      OrderRefundStatus       @default(no_refund) @map("refund_status")
  /// Field đồng bộ/báo cáo từ Sapo — không điều khiển nghiệp vụ nội bộ
  issueStatus       String?                 @map("issue_status")
  /// Cùng họ với return_status/refund_status nên cũng phải có default: để nullable thì
  /// mọi bộ lọc `restock_status = 'no_restock'` sẽ bỏ sót toàn bộ đơn chưa từng nhập lại.
  restockStatus     OrderRestockStatus      @default(no_restock) @map("restock_status")
  cancelReason      String?                 @map("cancel_reason")
  cancelledOn       DateTime?               @map("cancelled_on")
  closedOn          DateTime?               @map("closed_on")
  /// null = chưa xác nhận (~"ordered" cũ); có giá trị = đã xác nhận (~"processing" cũ)
  confirmedOn       DateTime?               @map("confirmed_on")
  completedOn       DateTime?               @map("completed_on")
  paidOn            DateTime?               @map("paid_on")
  /// Sapo `assignee_id` / `user_id`
  assignedToId      BigInt?                 @map("assignee_id")
  createdById       BigInt                  @map("user_id")
  email             String?
  phone             String?

  // --- Tiền tệ (tên theo Sapo) ---
  /// Sapo `sub_total_price` (Sapo trả thêm `subtotal_price` trùng giá trị)
  subTotalPrice             Decimal  @default(0) @map("sub_total_price") @db.Decimal(18, 2)
  totalDiscounts            Decimal  @default(0) @map("total_discounts") @db.Decimal(18, 2)
  totalTax                  Decimal  @default(0) @map("total_tax") @db.Decimal(18, 2)
  totalShippingPrice        Decimal  @default(0) @map("total_shipping_price") @db.Decimal(18, 2)
  totalPrice                Decimal  @default(0) @map("total_price") @db.Decimal(18, 2)
  subtotalLineItemsQuantity Int      @default(0) @map("subtotal_line_items_quantity")
  totalReceived             Decimal  @default(0) @map("total_received") @db.Decimal(18, 2)
  /// Các field tiền Sapo tính sẵn — chỉ đồng bộ/báo cáo, nghiệp vụ nội bộ tự tính lại
  currency                  String   @default("VND")
  gateway                   String?
  totalWeight               Int?     @map("total_weight")
  netPayment                Decimal? @map("net_payment") @db.Decimal(18, 2)
  unpaidAmount              Decimal? @map("unpaid_amount") @db.Decimal(18, 2)
  totalOutstanding          Decimal? @map("total_outstanding") @db.Decimal(18, 2)
  totalRefunded             Decimal? @map("total_refunded") @db.Decimal(18, 2)

  shippingMethod String?  @map("shipping_method")
  note           String?  @db.Text
  tags           String[] @default([])

  // --- Mốc thời gian (tên theo Sapo) ---
  /// Sapo `created_on` — ngày đặt hàng thật (KHÔNG phải lúc ghi vào DB này)
  createdOn            DateTime  @default(now()) @map("created_on")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  deliveredOn          DateTime? @map("delivered_on")
  processedOn          DateTime? @map("processed_on")
  settledOn            DateTime? @map("settled_on")
  issuedOn             DateTime? @map("issued_on")

  // Giao hàng — Sapo gom vào object `shipping_address`, ở đây trải phẳng theo
  // tiền tố `shipping_` (Postgres không có kiểu object; giữ phẳng để query/index).
  deliveryMode         OrderDeliveryMode @default(giao_hang_sau) @map("delivery_mode")
  shippingName         String?           @map("shipping_name")
  shippingFirstName    String?           @map("shipping_first_name")
  shippingLastName     String?           @map("shipping_last_name")
  shippingPhone        String?           @map("shipping_phone")
  shippingAddress1     String?           @map("shipping_address1")
  shippingAddress2     String?           @map("shipping_address2")
  shippingWard         String?           @map("shipping_ward")
  shippingWardCode     String?           @map("shipping_ward_code")
  shippingDistrict     String?           @map("shipping_district")
  shippingDistrictCode String?           @map("shipping_district_code")
  shippingProvince     String?           @map("shipping_province")
  shippingProvinceCode String?           @map("shipping_province_code")
  shippingCity         String?           @map("shipping_city")
  shippingCountry      String?           @map("shipping_country")
  shippingCountryCode  String?           @map("shipping_country_code")
  shippingZip          String?           @map("shipping_zip")
  shippingCompany      String?           @map("shipping_company")
  shippingLatitude     Decimal?          @map("shipping_latitude") @db.Decimal(10, 7)
  shippingLongitude    Decimal?          @map("shipping_longitude") @db.Decimal(10, 7)

  // Sapo `billing_address` — cùng cấu trúc, chỉ giữ các field thực sự dùng
  billingName     String? @map("billing_name")
  billingPhone    String? @map("billing_phone")
  billingAddress1 String? @map("billing_address1")
  billingWard     String? @map("billing_ward")
  billingDistrict String? @map("billing_district")
  billingProvince String? @map("billing_province")
  billingCountry  String? @map("billing_country")
  billingZip      String? @map("billing_zip")

  // Thông số kiện hàng (riêng của dự án — Sapo để ở fulfillment/shipping_lines)
  deliveryCodAmount   Decimal? @map("delivery_cod_amount") @db.Decimal(18, 2)
  deliveryWeightGrams Int?     @map("delivery_weight_grams")
  deliveryLengthCm    Int?     @map("delivery_length_cm")
  deliveryWidthCm     Int?     @map("delivery_width_cm")
  deliveryHeightCm    Int?     @map("delivery_height_cm")
  deliveryRequirement String?  @map("delivery_requirement")
  deliveryNote        String?  @map("delivery_note") @db.Text

  // Hóa đơn điện tử (chỉ lưu thông tin, không tích hợp tra cứu/xuất thật)
  invoiceTaxCode        String? @map("invoice_tax_code")
  invoiceCompanyName    String? @map("invoice_company_name")
  invoiceAddress        String? @map("invoice_address")
  invoiceBuyerName      String? @map("invoice_buyer_name")
  invoiceIdCard         String? @map("invoice_id_card")
  invoiceBudgetCode     String? @map("invoice_budget_code")
  invoicePhone          String? @map("invoice_phone")
  invoiceEmail          String? @map("invoice_email")
  invoiceSellToConsumer Boolean @default(false) @map("invoice_sell_to_consumer")

  /// Bỏ `created_at` cũ (chỉ là lúc sync vào DB này, không mang nghĩa nghiệp vụ)
  /// — ngày đặt hàng thật nằm ở `created_on`.
  modifiedOn DateTime @updatedAt @map("modified_on")

  customer       Customer?           @relation(fields: [customerId], references: [id])
  location       Location            @relation(fields: [locationId], references: [id])
  assignedTo     User?               @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items          OrderItem[]
  returns        OrderReturn[]
  refunds        OrderRefund[]
  fromDraft      DraftOrder?         @relation("DraftConverted")
  fulfillments   Fulfillment[]
  shippingLines  OrderShippingLine[]
  carrierTickets CarrierTicket[]

  @@index([locationId, status, createdOn])
  @@index([createdOn])
  @@index([customerId])
  @@index([assignedToId])
  @@map("orders")
}

/// Sapo `line_items` của Order
model OrderItem {
  id                     BigInt   @id @default(autoincrement())
  orderId                BigInt   @map("order_id")
  variantId              BigInt   @map("variant_id")
  /// Sapo `product_id` / `inventory_item_id` — lưu id gốc bên Sapo để đối soát
  productId              BigInt?  @map("product_id")
  inventoryItemId        BigInt?  @map("inventory_item_id")
  /// Sapo `name` (tên hiển thị đầy đủ) và `variant_title` (tên phiên bản)
  name                   String
  variantTitle           String?  @map("variant_title")
  sku                    String
  quantity               Int
  price                  Decimal  @db.Decimal(18, 2)
  /// Sapo `total_discount` / `discounted_total` / `original_total`
  totalDiscount          Decimal  @default(0) @map("total_discount") @db.Decimal(18, 2)
  discountedTotal        Decimal  @map("discounted_total") @db.Decimal(18, 2)
  originalTotal          Decimal? @map("original_total") @db.Decimal(18, 2)
  /// Không có ở Sapo — chốt giá vốn (`ProductVariant.cost`) tại thời điểm bán để báo cáo
  /// lợi nhuận kỳ cũ không trôi khi giá vốn thay đổi. NULL với đơn tạo trước tính năng này
  /// (báo cáo fallback về `variant.cost` hiện tại).
  costPrice              Decimal? @map("cost_price") @db.Decimal(18, 2)
  /// Số lượng theo từng trạng thái xử lý (Sapo tính sẵn) — đồng bộ/báo cáo
  fulfillableQuantity    Int?     @map("fulfillable_quantity")
  currentQuantity        Int?     @map("current_quantity")
  nonFulfillableQuantity Int?     @map("non_fulfillable_quantity")
  refundableQuantity     Int?     @map("refundable_quantity")
  grams                  Int?
  taxable                Boolean  @default(true)
  requiresShipping       Boolean  @default(true) @map("requires_shipping")
  restockable            Boolean  @default(true)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  // Không còn location riêng theo dòng: Sapo đặt location ở cấp đơn (`orders.location_id`).
  // Đã kiểm chứng 87.795/87.795 đơn chỉ dùng đúng 1 kho ⇒ không mất dữ liệu.
  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model ShippingProvider {
  id               BigInt               @id @default(autoincrement())
  code             String               @unique
  name             String
  type             ShippingProviderType
  isConnected      Boolean              @default(false) @map("is_connected")
  connectionConfig Json?                @map("connection_config")
  servicesConfig   Json?                @map("services_config")
  phone            String?
  email            String?
  note             String?              @db.Text
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  fulfillments   Fulfillment[]
  carrierTickets CarrierTicket[]

  @@map("shipping_providers")
}

/// Sapo `fulfillments` của Order — phiếu đóng gói + vận đơn
model Fulfillment {
  id      BigInt  @id @default(autoincrement())
  sapoId  BigInt? @unique @map("sapo_id")
  /// Sapo `name` — mã vận đơn nội bộ (vd FUN620368)
  name    String  @unique
  orderId BigInt  @map("order_id")
  storeId BigInt? @map("store_id")
  /// Sapo `status` — success | cancelled
  status  String  @default("success")

  // --- Đóng gói (Sapo `packed_status`) ---
  packedStatus          PackingStatus? @map("packed_status")
  assignedPackerId      BigInt?        @map("assigned_packer_id")
  packedOn              DateTime?      @map("packed_on")
  deliveryNotePrintedAt DateTime?      @map("delivery_note_printed_at")

  // --- Vận đơn ---
  shipmentStatus         ShipmentStatus?            @map("shipment_status")
  /// Sapo `delivery_method` — hàng rời kho theo cách nào
  deliveryMethod         FulfillmentDeliveryMethod? @map("delivery_method")
  shipmentCategory       ShipmentCategory?          @map("shipment_category")
  packageCategory        PackageCategory?           @map("package_category")
  /// Loại đối tác của dự án (tích hợp API vs tự liên hệ) — Sapo không tách khái niệm này
  shippingType           ShippingProviderType?      @map("shipping_type")
  providerId             BigInt?                    @map("provider_id")
  serviceCode            String?                    @map("service_code")
  serviceName            String?                    @map("service_name")
  /// Sapo `tracking_info` — mã vận đơn của hãng vận chuyển
  trackingNumber         String?                    @map("tracking_number")
  trackingUrl            String?                    @map("tracking_url")
  trackingCompany        String?                    @map("tracking_company")
  /// Sapo `tracking_info.carrier` / `carrier_name` (VIETTEL_POST, JT_EXPRESS, GHN...)
  carrier                String?
  carrierName            String?                    @map("carrier_name")
  /// Đơn ghép nhiều kiện — Sapo trả mảng
  trackingNumbers        String[]                   @default([]) @map("tracking_numbers")
  trackingUrls           String[]                   @default([]) @map("tracking_urls")
  shippingLabelSlipUrl   String?                    @map("shipping_label_slip_url")
  shippingLabelSlipError String?                    @map("shipping_label_slip_error")
  notifyCustomer         Boolean                    @default(false) @map("notify_customer")
  totalQuantity          Int                        @default(0) @map("total_quantity")
  /// Sapo `sla` (object fast/confirm/avoid_cancellation) + `abnormal` + `picking_issues`
  sla                    Json?
  abnormal               Json?
  pickingIssues          Json?                      @map("picking_issues")

  // --- Kích thước/phí (của dự án — Sapo để ở shipping_lines/ĐTVC) ---
  shippingFee         Decimal          @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  feePayer            ShippingFeePayer @default(shop_tra) @map("fee_payer")
  codAmount           Decimal          @default(0) @map("cod_amount") @db.Decimal(18, 2)
  weightGrams         Int?             @map("weight_grams")
  lengthCm            Int?             @map("length_cm")
  widthCm             Int?             @map("width_cm")
  heightCm            Int?             @map("height_cm")
  deliveryRequirement String?          @map("delivery_requirement")
  note                String?          @db.Text

  // --- Địa chỉ nhận (snapshot; Sapo lấy từ order.shipping_address) ---
  toName     String? @map("to_name")
  toPhone    String? @map("to_phone")
  toAddress  String? @map("to_address")
  toWard     String? @map("to_ward")
  toDistrict String? @map("to_district")
  toProvince String? @map("to_province")

  // --- Địa chỉ lấy hàng (Sapo `origin_address`) ---
  locationId         BigInt? @map("location_id")
  originName         String? @map("origin_name")
  originEmail        String? @map("origin_email")
  originPhone        String? @map("origin_phone")
  originAddress1     String? @map("origin_address1")
  originAddress2     String? @map("origin_address2")
  originWard         String? @map("origin_ward")
  originWardCode     String? @map("origin_ward_code")
  originDistrict     String? @map("origin_district")
  originDistrictCode String? @map("origin_district_code")
  originProvince     String? @map("origin_province")
  originProvinceCode String? @map("origin_province_code")
  originCity         String? @map("origin_city")
  originCountry      String? @map("origin_country")
  originCountryCode  String? @map("origin_country_code")
  originZipCode      String? @map("origin_zip_code")

  // --- Mốc thời gian (tên theo Sapo) ---
  shipmentCreatedOn    DateTime? @map("shipment_created_on")
  pickedOn             DateTime? @map("picked_on")
  pickedUserId         BigInt?   @map("picked_user_id")
  sortedOn             DateTime? @map("sorted_on")
  sortedUserId         BigInt?   @map("sorted_user_id")
  inspectedOn          DateTime? @map("inspected_on")
  issuedOn             DateTime? @map("issued_on")
  issuedBy             String?   @map("issued_by")
  issuedUserId         BigInt?   @map("issued_user_id")
  issuedClientId       BigInt?   @map("issued_client_id")
  handedOverAt         DateTime? @map("handed_over_at")
  handedBy             String?   @map("handed_by")
  handedUserId         BigInt?   @map("handed_user_id")
  pickedUpAt           DateTime? @map("picked_up_at")
  deliveredOn          DateTime? @map("delivered_on")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  orderShipDeadline    DateTime? @map("order_ship_deadline")
  returnedAt           DateTime? @map("returned_at")
  cancelledOn          DateTime? @map("cancelled_on")
  closedAt             DateTime? @map("closed_at")
  cancelReason         String?   @map("cancel_reason")
  createdById          BigInt    @map("created_by")
  createdOn            DateTime  @default(now()) @map("created_on")
  modifiedOn           DateTime  @updatedAt @map("modified_on")

  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packer         User?                 @relation("FulfillmentPacker", fields: [assignedPackerId], references: [id])
  provider       ShippingProvider?     @relation(fields: [providerId], references: [id])
  location       Location?             @relation(fields: [locationId], references: [id])
  createdBy      User                  @relation("FulfillmentCreatedBy", fields: [createdById], references: [id])
  items          FulfillmentLineItem[]
  carrierTickets CarrierTicket[]

  // CẢNH BÁO: DB còn một partial unique index mà Prisma KHÔNG mô tả được nên không có ở
  // đây — `fulfillments_one_open_per_order` trên (order_id) WHERE closed_at IS NULL: mỗi
  // đơn chỉ được có MỘT vận đơn đang mở. Vì Prisma không thấy nó, `tsc` cũng không thấy;
  // code tạo vận đơn phải tự kiểm tra vận đơn đang mở của đơn trước khi `create`, nếu không
  // sẽ vỡ ở tầng DB lúc chạy thật (đã gặp khi đồng bộ TikTok 2026-08-15).
  @@index([orderId])
  @@index([shipmentStatus])
  @@map("fulfillments")
}

/// Sapo `fulfillment.line_items` — dòng hàng thuộc một phiếu giao
model FulfillmentLineItem {
  id                     BigInt   @id @default(autoincrement())
  fulfillmentId          BigInt   @map("fulfillment_id")
  /// Sapo `line_item_id` — trỏ về dòng hàng của đơn
  orderItemId            BigInt?  @map("order_item_id")
  variantId              BigInt   @map("variant_id")
  productId              BigInt?  @map("product_id")
  name                   String
  title                  String?
  variantTitle           String?  @map("variant_title")
  sku                    String
  quantity               Int
  /// Sapo `effective_quantity` — số lượng thực giao sau khi trừ phần hủy/hoàn
  effectiveQuantity      Int?     @map("effective_quantity")
  fulfillableQuantity    Int?     @map("fulfillable_quantity")
  nonFulfillableQuantity Int?     @map("non_fulfillable_quantity")
  refundableQuantity     Int?     @map("refundable_quantity")
  price                  Decimal  @db.Decimal(18, 2)
  totalDiscount          Decimal  @default(0) @map("total_discount") @db.Decimal(18, 2)
  discountedTotal        Decimal  @map("discounted_total") @db.Decimal(18, 2)
  originalTotal          Decimal? @map("original_total") @db.Decimal(18, 2)
  grams                  Int?
  taxable                Boolean  @default(true)
  requiresShipping       Boolean  @default(true) @map("requires_shipping")
  restockable            Boolean  @default(true)
  fulfillmentStatus      String?  @map("fulfillment_status")

  fulfillment Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([fulfillmentId])
  @@index([variantId])
  @@map("fulfillment_line_items")
}

/// Sapo `order.shipping_lines` — dòng phí/phương thức vận chuyển của đơn
model OrderShippingLine {
  id                  BigInt  @id @default(autoincrement())
  orderId             BigInt  @map("order_id")
  /// Sapo `title` / `code` — vd "Vận hành bởi nhà bán hàng" / sapo_fulfillment_by_seller
  title               String?
  code                String?
  source              String?
  price               Decimal @default(0) @db.Decimal(18, 2)
  carrier             String?
  carrierName         String? @map("carrier_name")
  /// Sapo `discount_allocations` / `tax_lines` — mảng, chỉ lưu đối soát
  discountAllocations Json?   @map("discount_allocations")
  taxLines            Json?   @map("tax_lines")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_shipping_lines")
}

/// Trạng thái ticket của GHN ("1 - Đang xử lý" / "2 - Chờ KH phản hồi" / "3 - Hoàn thành")
enum CarrierTicketStatus {
  dang_xu_ly
  cho_phan_hoi
  hoan_thanh
}

/// 4 nhóm ticket GHN cho phép tạo
enum CarrierTicketCategory {
  tu_van
  hoi_giao_lay_tra_hang
  thay_doi_thong_tin
  khieu_nai
}

/// Phiếu hỗ trợ mở với hãng vận chuyển (GHN `ticket/*`). Sapo không có khái niệm này nên
/// đây là bảng riêng của dự án, đặt tên theo vốn từ của hãng.
model CarrierTicket {
  id                BigInt                @id @default(autoincrement())
  providerId        BigInt                @map("provider_id")
  fulfillmentId     BigInt?               @map("fulfillment_id")
  orderId           BigInt?               @map("order_id")
  /// GHN `id` — khóa để upsert khi callback/đồng bộ về
  externalId        String                @unique @map("external_id")
  /// GHN `order_code` = mã vận đơn (`fulfillments.tracking_number`)
  orderCode         String                @map("order_code")
  category          CarrierTicketCategory
  status            CarrierTicketStatus   @default(dang_xu_ly)
  /// Giá trị thô của hãng, giữ lại vì GHN có thể thêm trạng thái mới
  statusRaw         String?               @map("status_raw")
  description       String                @db.Text
  attachments       Json?
  contactName       String?               @map("contact_name")
  contactEmail      String?               @map("contact_email")
  contactPhone      String?               @map("contact_phone")
  createdById       BigInt?               @map("created_by")
  externalCreatedAt DateTime?             @map("external_created_at")
  externalUpdatedAt DateTime?             @map("external_updated_at")
  syncedAt          DateTime?             @map("synced_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  provider    ShippingProvider       @relation(fields: [providerId], references: [id])
  fulfillment Fulfillment?           @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)
  order       Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("CarrierTicketCreatedBy", fields: [createdById], references: [id])
  messages    CarrierTicketMessage[]

  @@index([orderCode])
  @@index([status])
  @@index([fulfillmentId])
  @@map("carrier_tickets")
}

/// GHN `ticket.conversations[]` — trao đổi qua lại trong một ticket
model CarrierTicketMessage {
  id                BigInt    @id @default(autoincrement())
  ticketId          BigInt    @map("ticket_id")
  /// shop = mình gửi, carrier = hãng trả lời
  senderType        String    @map("sender_type")
  fromEmail         String?   @map("from_email")
  body              String    @db.Text
  attachments       Json?
  externalCreatedAt DateTime? @map("external_created_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  ticket CarrierTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, externalCreatedAt])
  @@map("carrier_ticket_messages")
}

model DraftOrder {
  id                 BigInt           @id @default(autoincrement())
  code               String           @unique
  locationId         BigInt           @map("location_id")
  customerId         BigInt?          @map("customer_id")
  source             OrderSource      @default(other)
  status             DraftOrderStatus @default(draft)
  createdById        BigInt           @map("created_by")
  currency           String           @default("VND")
  subtotal           Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal          @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal           Decimal          @default(0) @map("tax_total") @db.Decimal(18, 2)
  shippingFee        Decimal          @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  totalAmount        Decimal          @default(0) @map("total_amount") @db.Decimal(18, 2)
  shippingMethod     String?          @map("shipping_method")
  note               String?          @db.Text
  tags               String[]         @default([])
  expectedDeliveryAt DateTime?        @map("expected_delivery_at")
  convertedOrderId   BigInt?          @unique @map("converted_order_id")

  // Giao hàng (nhập lúc tạo đơn — chỉ lưu thông tin, không tự tạo vận đơn)
  deliveryMode        OrderDeliveryMode @default(giao_hang_sau) @map("delivery_mode")
  deliveryToName      String?           @map("delivery_to_name")
  deliveryToPhone     String?           @map("delivery_to_phone")
  deliveryToAddress   String?           @map("delivery_to_address")
  deliveryToWard      String?           @map("delivery_to_ward")
  deliveryToDistrict  String?           @map("delivery_to_district")
  deliveryToProvince  String?           @map("delivery_to_province")
  deliveryCodAmount   Decimal?          @map("delivery_cod_amount") @db.Decimal(18, 2)
  deliveryWeightGrams Int?              @map("delivery_weight_grams")
  deliveryLengthCm    Int?              @map("delivery_length_cm")
  deliveryWidthCm     Int?              @map("delivery_width_cm")
  deliveryHeightCm    Int?              @map("delivery_height_cm")
  deliveryRequirement String?           @map("delivery_requirement")
  deliveryNote        String?           @map("delivery_note") @db.Text

  // Hóa đơn điện tử (chỉ lưu thông tin, không tích hợp tra cứu/xuất thật)
  invoiceTaxCode        String? @map("invoice_tax_code")
  invoiceCompanyName    String? @map("invoice_company_name")
  invoiceAddress        String? @map("invoice_address")
  invoiceBuyerName      String? @map("invoice_buyer_name")
  invoiceIdCard         String? @map("invoice_id_card")
  invoiceBudgetCode     String? @map("invoice_budget_code")
  invoicePhone          String? @map("invoice_phone")
  invoiceEmail          String? @map("invoice_email")
  invoiceSellToConsumer Boolean @default(false) @map("invoice_sell_to_consumer")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location       Location         @relation(fields: [locationId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  createdBy      User             @relation("DraftOrderCreatedBy", fields: [createdById], references: [id])
  convertedOrder Order?           @relation("DraftConverted", fields: [convertedOrderId], references: [id])
  items          DraftOrderItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("draft_orders")
}

model DraftOrderItem {
  id           BigInt  @id @default(autoincrement())
  draftOrderId BigInt  @map("draft_order_id")
  variantId    BigInt  @map("variant_id")
  productName  String  @map("product_name")
  sku          String
  quantity     Int
  price        Decimal @db.Decimal(18, 2)
  discount     Decimal @default(0) @db.Decimal(18, 2)

  draftOrder DraftOrder     @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  // Location ở cấp đơn nháp (`draft_orders.location_id`) — xem ghi chú ở OrderItem.
  @@index([draftOrderId])
  @@index([variantId])
  @@map("draft_order_items")
}

/// Phiếu trả hàng — tương ứng `return_id` mà Sapo gắn lên refund.
/// Tiền hoàn và việc nhập lại kho nằm ở `OrderRefund` (giống Sapo).
model OrderReturn {
  id          BigInt   @id @default(autoincrement())
  sapoId      BigInt?  @unique @map("sapo_id")
  code        String   @unique
  orderId     BigInt   @map("order_id")
  reason      String?  @db.Text
  createdById BigInt   @map("created_by")
  createdOn   DateTime @default(now()) @map("created_on")

  order     Order         @relation(fields: [orderId], references: [id])
  createdBy User          @relation("OrderReturnCreatedBy", fields: [createdById], references: [id])
  refunds   OrderRefund[]

  @@index([orderId])
  @@index([createdOn])
  @@map("order_returns")
}

/// Sapo `order.refunds[]` — bản ghi hoàn tiền, dùng chung cho CẢ hai luồng:
/// trả hàng (`returnId` khác null) và huỷ đơn (`returnId` = null).
/// Sapo vẫn tạo refund kể cả khi `totalRefunded` = 0 (trả hàng không hoàn tiền).
model OrderRefund {
  id            BigInt   @id @default(autoincrement())
  sapoId        BigInt?  @unique @map("sapo_id")
  orderId       BigInt   @map("order_id")
  returnId      BigInt?  @map("return_id")
  note          String?  @db.Text
  /// Sapo `restock` — có nhập lại kho hay không (tổng hợp của các dòng)
  restock       Boolean  @default(false)
  totalRefunded Decimal  @default(0) @map("total_refunded") @db.Decimal(18, 2)
  processedAt   DateTime @default(now()) @map("processed_at")
  createdById   BigInt   @map("user_id")
  createdOn     DateTime @default(now()) @map("created_on")

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderReturn OrderReturn?          @relation(fields: [returnId], references: [id])
  createdBy   User                  @relation("OrderRefundCreatedBy", fields: [createdById], references: [id])
  lineItems   OrderRefundLineItem[]

  @@index([orderId])
  @@index([returnId])
  @@map("order_refunds")
}

/// Sapo `refund.refund_line_items[]`
model OrderRefundLineItem {
  id           BigInt      @id @default(autoincrement())
  sapoId       BigInt?     @unique @map("sapo_id")
  refundId     BigInt      @map("refund_id")
  /// Sapo `line_item_id`
  orderItemId  BigInt?     @map("order_item_id")
  variantId    BigInt      @map("variant_id")
  locationId   BigInt      @map("location_id")
  productName  String      @map("product_name")
  sku          String
  variantTitle String?     @map("variant_title")
  quantity     Int
  price        Decimal     @db.Decimal(18, 2)
  subtotal     Decimal     @default(0) @db.Decimal(18, 2)
  totalTax     Decimal     @default(0) @map("total_tax") @db.Decimal(18, 2)
  /// Sapo `restock_type` — quyết định dòng này có nhập lại kho không
  restockType  RestockType @map("restock_type")

  refund   OrderRefund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  location Location       @relation(fields: [locationId], references: [id])

  @@index([refundId])
  @@index([variantId])
  @@index([locationId])
  @@map("order_refund_items")
}

model Voucher {
  id             BigInt      @id @default(autoincrement())
  code           String      @unique
  type           VoucherType
  amountIn       Decimal     @default(0) @map("amount_in") @db.Decimal(18, 2)
  amountOut      Decimal     @default(0) @map("amount_out") @db.Decimal(18, 2)
  locationId     BigInt      @map("location_id")
  createdById    BigInt      @map("created_by")
  sourceDocument String?     @map("source_document")
  referenceType  String?     @map("reference_type")
  referenceId    BigInt?     @map("reference_id")
  reason         String?     @db.Text
  recordedAt     DateTime    @default(now()) @map("recorded_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  location  Location @relation(fields: [locationId], references: [id])
  createdBy User     @relation("VoucherCreatedBy", fields: [createdById], references: [id])

  @@index([locationId, type, recordedAt])
  @@map("vouchers")
}

// --- Báo cáo (008) ---

/// Báo cáo người dùng lưu/ghim lên màn tổng quan. Bản thân báo cáo KHÔNG có bảng dữ liệu
/// riêng — số liệu tổng hợp trực tiếp từ các bảng nghiệp vụ theo `report_key`.
model SavedReport {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// Id báo cáo trong `report-registry.ts` (vd `sales-revenue-by-time`)
  reportKey String   @map("report_key")
  /// Bộ lọc đã lưu kèm (khoảng thời gian, kho, kênh...) — dạng snake_case như query API
  filters   Json?
  isPinned  Boolean  @default(true) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("SavedReportUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportKey])
  @@index([userId, isPinned])
  @@map("saved_reports")
}

/// API key tĩnh cho đối tác bên thứ 3 gọi API server-to-server, không qua login/JWT.
/// Chỉ `keyHash` (SHA-256) được lưu — raw key chỉ hiển thị đúng một lần lúc tạo.
model ApiKey {
  id           BigInt    @id @default(autoincrement())
  name         String
  /// 12 ký tự đầu của raw key — chỉ để hiển thị trong danh sách quản lý, KHÔNG dùng để xác thực.
  keyPrefix    String    @map("key_prefix")
  keyHash      String    @unique @map("key_hash")
  /// Key xác thực THAY user này — quyền của key = quyền THẬT của user (qua RbacService),
  /// y hệt đăng nhập JWT. Không có phân quyền riêng cho API key: muốn key hẹp quyền thì
  /// tạo user dịch vụ với role hẹp, muốn toàn quyền thì trỏ vào user có role admin.
  actingUserId BigInt    @map("acting_user_id")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdById  BigInt    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  actingUser User @relation("ApiKeyActingUser", fields: [actingUserId], references: [id])
  createdBy  User @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@map("api_keys")
}

// --- Chat CSKH (002 US4) ---

model Conversation {
  id            BigInt      @id @default(autoincrement())
  channel       OrderSource @default(other)
  customerName  String      @map("customer_name")
  customerPhone String      @map("customer_phone")
  customerId    BigInt?     @map("customer_id")
  assignedToId  BigInt?     @map("assigned_to")
  lastMessageAt DateTime    @default(now()) @map("last_message_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer   Customer?             @relation(fields: [customerId], references: [id])
  assignedTo User?                 @relation("ConversationAssignedTo", fields: [assignedToId], references: [id])
  messages   ConversationMessage[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  senderType     String   @map("sender_type")
  body           String   @db.Text
  createdById    BigInt?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ConversationMessageAuthor", fields: [createdById], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

// --- CQA CSKH / Facebook inbox ---

model ChatAudit {
  id           String   @id @default(uuid()) @db.Uuid
  userId       BigInt?  @map("user_id")
  agentName    String?  @map("agent_name") @db.VarChar
  customerName String?  @map("customer_name") @db.VarChar
  channel      String?  @db.VarChar
  score        Int      @default(0)
  feedback     String?  @db.Text
  transcript   Json?
  metadata     Json?
  tenantId     String?  @map("tenant_id") @db.Uuid
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("chat_audits")
}

model FacebookCskhConfig {

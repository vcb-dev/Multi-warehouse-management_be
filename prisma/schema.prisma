  fbUserId        String    @unique @map("fb_user_id")
  fbUserName      String?   @map("fb_user_name") @db.VarChar
  userAccessToken String    @map("user_access_token") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamptz(6)
  metadata        Json?
  tenantId        String?   @map("tenant_id") @db.Uuid
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("facebook_oauth_sessions")

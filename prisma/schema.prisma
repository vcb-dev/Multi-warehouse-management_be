model CskhJobRun {
  id           String            @id @default(uuid()) @db.Uuid
  type         String
  status       String            @default("running")
  summary      Json?
  error        String?           @db.Text
  tenantId     String?           @map("tenant_id") @db.Uuid
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedAt    DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz(6)
  monitorItems CskhMonitorItem[]

  @@map("cskh_job_runs")
}

model CskhMonitorItem {
  id             String     @id @default(uuid()) @db.Uuid
  jobRunId       String     @map("job_run_id") @db.Uuid
  pageId         String     @map("page_id")
  pageName       String?    @map("page_name") @db.VarChar
  conversationId String     @map("conversation_id")
  customerName   String?    @map("customer_name") @db.VarChar
  lastMessage    String?    @map("last_message") @db.Text
  needsReply     Boolean    @default(true) @map("needs_reply")
  tenantId       String?    @map("tenant_id") @db.Uuid
  tenant         Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt      DateTime?  @map("updated_at") @db.Timestamptz(6)
  jobRun         CskhJobRun @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@map("cskh_monitor_items")
}

model CskhInboxConversation {
  id                 String                       @id @default(uuid()) @db.Uuid
  pageId             String                       @map("page_id")
  pageName           String?                      @map("page_name") @db.VarChar
  fbConversationId   String?                      @map("fb_conversation_id") @db.VarChar
  participantPsid    String                       @map("participant_psid")
  customerName       String?                      @map("customer_name") @db.VarChar
  customerPictureUrl String?                      @map("customer_picture_url") @db.VarChar
  lastMessage        String?                      @map("last_message") @db.Text
  lastMessageAt      DateTime?                    @map("last_message_at") @db.Timestamptz(6)
  unreadCount        Int                          @default(0) @map("unread_count")
  awaitingLabel      Boolean                      @default(false) @map("awaiting_label")
  fromAd             Boolean                      @default(false) @map("from_ad")
  adId               String?                      @map("ad_id") @db.VarChar
  adTitle            String?                      @map("ad_title") @db.VarChar
  referralSource     String?                      @map("referral_source") @db.VarChar
  referralAt         DateTime?                    @map("referral_at") @db.Timestamptz(6)
  tenantId           String?                      @map("tenant_id") @db.Uuid
  tenant             Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages           CskhInboxMessage[]
  labelAssignments   CskhInboxConversationLabel[]
  views              CskhInboxConversationView[]

  @@unique([pageId, participantPsid])
  @@index([tenantId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([pageId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, fromAd, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("cskh_inbox_conversations")
}

model CskhInboxMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  fbMessageId    String?               @unique @map("fb_message_id") @db.VarChar
  direction      String
  senderType     String                @map("sender_type")
  text           String                @db.Text
  messageType    String                @default("text") @map("message_type")
  attachmentUrl  String?               @map("attachment_url") @db.Text
  tenantId       String?               @map("tenant_id") @db.Uuid
  tenant         Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sentAt         DateTime              @default(now()) @map("sent_at") @db.Timestamptz(6)
  status         String                @default("sent")
  conversation   CskhInboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId, sentAt(sort: Desc)])
  @@index([sentAt(sort: Desc)])
  @@index([direction, sentAt(sort: Desc)])
  @@map("cskh_inbox_messages")
}

model CskhInboxLabel {
  id          String                       @id @default(uuid()) @db.Uuid
  tenantId    String?                      @map("tenant_id") @db.Uuid
  tenant      Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String                       @db.VarChar(80)
  color       String                       @default("#6366f1") @db.VarChar(20)
  type        String                       @db.VarChar(20)
  userId      BigInt?                      @map("user_id")
  user        User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sortOrder   Int                          @default(0) @map("sort_order")
  isActive    Boolean                      @default(true) @map("is_active")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments CskhInboxConversationLabel[]

  @@unique([tenantId, type, userId])
  @@unique([tenantId, type, name])
  @@index([tenantId, type, sortOrder])
  @@map("cskh_inbox_labels")
}

model CskhInboxConversationLabel {
  id               String                @id @default(uuid()) @db.Uuid
  conversationId   String                @map("conversation_id") @db.Uuid
  labelId          String                @map("label_id") @db.Uuid
  assignedByUserId BigInt?               @map("assigned_by_user_id")
  assignedAt       DateTime              @default(now()) @map("assigned_at") @db.Timestamptz(6)
  conversation     CskhInboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label            CskhInboxLabel        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([conversationId, labelId])
  @@index([conversationId])
  @@index([labelId])
  @@map("cskh_inbox_conversation_labels")
}

model CskhInboxConversationView {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  userId         BigInt                @map("user_id")
  viewedAt       DateTime              @default(now()) @map("viewed_at") @db.Timestamptz(6)
  conversation   CskhInboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId, viewedAt(sort: Desc)])
  @@map("cskh_inbox_conversation_views")
}

model CskhPageAdSpendDaily {
  id                     String   @id @default(uuid()) @db.Uuid
  pageId                 String   @map("page_id")
  statDate               String   @map("stat_date") @db.VarChar(10)
  spend                  Float?
  currency               String?  @db.VarChar(8)
  messagingConversations Int?     @map("messaging_conversations")
  costPerConversation    Float?   @map("cost_per_conversation")
  adAccountId            String?  @map("ad_account_id")
  adAccountName          String?  @map("ad_account_name") @db.VarChar
  unavailableReason      String?  @map("unavailable_reason") @db.VarChar(64)
  tenantId               String?  @map("tenant_id") @db.Uuid
  syncedAt               DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([pageId, statDate])
  @@index([statDate])
  @@index([tenantId, statDate])
  @@map("cskh_page_ad_spend_daily")
}

// --- Thông báo in-app ---

/// Một dòng = MỘT sự kiện đã xảy ra, không gắn user. Người nhận nằm ở
/// `NotificationRecipient` (fan-out), vì một đơn mới cần hiện cho N nhân viên của kho
/// đó — gộp chung một bảng sẽ nhân bản `title`/`payload` N lần.
model Notification {
  id BigInt @id @default(autoincrement())

  topic NotificationTopic

  /// Loại đối tượng: `order` | `fulfillment` | `customer` | `order_refund`.
  /// Chuỗi tự do chứ không phải FK — thông báo trỏ tới nhiều bảng khác nhau.
  subjectType String @map("subject_type")
  subjectId   BigInt @map("subject_id")

  /// Kho phát sinh sự kiện — dùng để fan-out đúng người theo scope kho.
  /// NULL = sự kiện không thuộc kho nào (vd khách hàng mới) ⇒ gửi cho mọi user có quyền.
  locationId BigInt? @map("location_id")

  /// Câu tiếng Việt render sẵn lúc emit, vd "Đơn HK93656 đã được thanh toán".
  title String

  /// Snapshot dữ liệu tại thời điểm emit (mã đơn, tiền, tên khách, hãng vận chuyển...).
  /// Render sẵn + snapshot để danh sách thông báo KHÔNG phải join sang `orders` —
  /// bảng đó đang ~88k dòng, join mỗi lần mở chuông là phí vô ích.
  payload Json?

  createdOn DateTime @default(now()) @map("created_on")

  location   Location?               @relation("NotificationLocation", fields: [locationId], references: [id])
  recipients NotificationRecipient[]

  @@index([subjectType, subjectId])
  @@index([createdOn])
  @@map("notifications")
}

/// Fan-out: ai nhận thông báo nào, và đã đọc chưa.
model NotificationRecipient {
  notificationId BigInt @map("notification_id")
  userId         BigInt @map("user_id")

  /// Giai đoạn 1 luôn `app`. Cột dựng sẵn cho `email` — chưa có code nào ghi giá trị khác.
  channel String @default("app")

  readOn DateTime? @map("read_on")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId, channel])
  /// Index chủ lực: đếm badge chưa đọc + phân trang keyset theo user (mới nhất trước)
  @@index([userId, readOn, notificationId(sort: Desc)])
  @@map("notification_recipients")
}

/// Cấu hình theo từng topic — nguồn dữ liệu của trang `/cau-hinh/thong-bao`.
model NotificationSetting {
  id BigInt @id @default(autoincrement())

  topic NotificationTopic @unique

  /// Tắt = `emit` không sinh dòng nào cho topic này.
  appEnabled Boolean @default(true) @map("app_enabled")

  /// Dựng sẵn cho giai đoạn email — hiện KHÔNG có code nào đọc field này.
  emailEnabled Boolean @default(false) @map("email_enabled")

  /// Ai nhận: mảng permission key (vd `["order:view"]`), user phải có ĐỦ mọi key.
  /// Mảng rỗng = mọi user đang hoạt động đều nhận.
  /// Dùng permission thay vì role vì RBAC dự án là động (admin tự tạo/xoá role),
  /// hard-code tên role vào đây sẽ vỡ ngay khi ai đó đổi tên role.
  recipientPermissions String[] @default([]) @map("recipient_permissions")

  createdOn  DateTime @default(now()) @map("created_on")
  modifiedOn DateTime @updatedAt @map("modified_on")

  @@map("notification_settings")
}
